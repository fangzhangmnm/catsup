{
 "note": "改了哪里 → 建议跑哪些探针（测试分档第四节；ai-docs/20261110-test-tiers.md）。npm run test:changed 末尾按这张表提醒，不自动跑。when = 路径前缀；以 /* 结尾 = 只算这个文件夹里直接的文件。每条只挑几个最有代表性的，不求全；改到某一块、心里清楚还碰到哪个探针，照样点名跑。脚本和人都读这一份；守卫 test/test-tiers-guard.test.ts 查每个探针、每个前缀都存在。created 2026-11-10 by Claude Opus 5.5",
 "rules": [
  { "when": ["src/editor/surface-assign.ts", "src/editor/modes/surface.ts"], "probes": ["probe-mesh-bucket.mjs"], "why": "油漆桶（表面工作台；W-12 起也管网格体的面）" },
  { "when": ["src/controller/lock-drag.ts", "src/editor/tools/mesh-grab.ts", "src/editor/tools/mesh-transform.ts", "src/editor/tools/mesh-pull.ts"], "probes": ["probe-lock-plane-drag.mjs"], "why": "拖动的位移（锁面跟手，W-13）" },
  { "when": ["src/mesh/", "src/editor/mesh-edits/"], "probes": ["probe-mesh-workbench.mjs", "probe-mesh-bevel.mjs", "probe-mesh-subdivide.mjs", "probe-mesh-knife.mjs", "probe-pool-mesh.mjs"], "why": "网格体内核 / 网格体指令：自由建模的几个代表" },
  { "when": ["src/editor/tools/mesh-"], "probes": ["probe-mesh-handles.mjs", "probe-mesh-pull.mjs", "probe-mesh-transform.mjs", "probe-mesh-knife.mjs", "probe-finish-chip.mjs", "probe-afterthought-ok.mjs"], "why": "自由建模的工具手势" },
  { "when": ["src/editor/param-panel.ts", "src/app/vcb.ts", "src/editor/mesh-edits/", "src/mesh/ops/loopcut.ts"], "probes": ["probe-afterthought-ok.mjs", "probe-vcb.mjs", "probe-axes-to-sel.mjs"], "why": "参数小窗（马后炮、确定、刀和环切的小窗）" },
  { "when": ["src/editor/tools/"], "probes": ["probe-pen.mjs", "probe-touch.mjs", "probe-steps.mjs", "probe-taps.mjs", "probe-finish-chip.mjs"], "why": "工具的手势（笔 / 手指 / 多步）" },
  { "when": ["src/kernel/"], "probes": ["probe-scene.mjs", "probe-lift.mjs", "probe-weld.mjs", "probe-two-sides.mjs"], "why": "硬表面内核" },
  { "when": ["src/editor/repairs/"], "probes": ["probe-repair-panel.mjs", "probe-repair-scope.mjs", "probe-slow-ask.mjs", "probe-cleanup.mjs"], "why": "修复指令" },
  { "when": ["src/editor/objects/", "src/editor/commands/"], "probes": ["probe-objects-merge.mjs", "probe-clipboard.mjs", "probe-nested-preview.mjs", "probe-undo-fuzz.mjs"], "why": "物件层动词 / 菜单指令" },
  { "when": ["src/editor/move/"], "probes": ["probe-move-copy.mjs", "probe-move-grid.mjs", "probe-twin-preview.mjs"], "why": "移动 / 复制" },
  { "when": ["src/editor/modes/"], "probes": ["probe-mesh-workbench.mjs", "probe-workbench-cross.mjs", "probe-reload-mode.mjs", "probe-surface.mjs"], "why": "工作台 / 模式" },
  { "when": ["src/editor/*"], "probes": ["probe-undo-session.mjs", "probe-undo-fuzz.mjs", "probe-clipboard.mjs", "probe-hover.mjs"], "why": "编辑器本体（撤销、剪贴板、悬停拾取）" },
  { "when": ["src/editor/history.ts", "src/paint/boards.ts", "src/paint/space-paint.ts", "src/editor/last-step.ts"], "probes": ["probe-paint-undo.mjs", "probe-undo-fuzz.mjs"], "why": "撤销：画的每一步进三维的撤销栈（1-8a）+ 编辑器级撤销随机串" },
  { "when": ["src/app/paint-workbench.ts", "src/app/paint-color.ts", "src/app/paint-sliders.ts", "src/editor/modes/paint.ts", "src/editor/mesh-edits/start-paint.ts", "src/app/gestures.ts", "src/paint/space-paint.ts"], "probes": ["probe-paint-workbench.mjs"], "why": "画画工作台（1-7）：开始画、画 / 擦 / 撤 / 重做、吸管、手指转视角不画、一笔当中相机不动、出了工作台笔照旧、存了重开、颜色面板、量" },
  { "when": ["src/paint/save.ts", "src/paint/boards.ts", "src/app/session.ts", "src/format/texture-table.ts", "src/minccino/providers/three/render3.ts"], "probes": ["probe-paint-save.mjs"], "why": "画存进文件、读回来（1-8b）：冷的照合成图显示、冷热逐像素相同、落笔撞冷画、编码中改动仍算改过、编码出错不动文件" },
  { "when": ["src/paint/board.ts", "src/paint/boards.ts", "src/paint/tile-jobs.ts", "src/paint/kernel/src/shell/gl-board.ts", "src/paint/kernel/src/backend/gl/render-tree.ts"], "probes": ["probe-paint-gpu-release.mjs"], "why": "扔画板时显卡上那份全还（0-3a：内核建的纹理 / 帧缓冲 = 删的）" },
  { "when": ["src/paint/space-", "src/paint/tip-truth.ts", "src/paint/board.ts", "src/paint/boards.ts", "src/minccino/contract/offscreen-gpu.ts", "src/minccino/providers/three/offscreen-gpu-gl.ts"], "probes": ["probe-space-gpu.mjs", "probe-space-rules.mjs", "probe-space-measure.mjs", "probe-paint-display.mjs"], "why": "空间里的一笔（1-4b）：真显卡 = 软件版、看得见的规矩、量" },
  { "when": ["src/paint/", "src/minccino/contract/offscreen-gpu.ts", "src/minccino/providers/three/offscreen-gpu-gl.ts", "src/minccino/providers/three/render3.ts", "src/app/session.ts"], "probes": ["probe-paint-scale.mjs", "probe-paint-open-memory.mjs"], "why": "打开一张画占多少显存 = 面板上说的（施工单十五，open-memory.ts 那张清单）；画的规模样本（1-4c 门禁：改画的显示 / 笔 / 存盘都跑）：细分盒子 96…24576 张面都画得上、6144 张面整条（带强行对称、4194304 格各一遍）、每张面三角形上限；真模型那一档手动加 --models=…" },
  { "when": ["src/app/canvas-window.ts", "src/app/ui/image-view.ts", "src/app/ui/menu-window.ts", "src/paint/atlas-outline.ts", "src/paint/board.ts", "src/paint/save.ts", "src/editor/highlight.ts", "src/editor/view-state.ts"], "probes": ["probe-canvas-window.mjs"], "why": "画布小窗（施工单十六）：线的条数 = atlas 上的面、两边一起亮、小窗里点 = 三维里选中、底下那行数和铺法 / 存盘对得上、开着画一笔一笔当中不读回" },
  { "when": ["src/minccino/providers/three/render3.ts", "src/app/session.ts", "src/app/gallery-host.ts", "src/paint/boards.ts", "src/paint/tile-jobs.ts", "src/paint/space-prep.ts"], "probes": ["probe-ten-files.mjs"], "why": "连开十份画过的文件（统筹 11-11）：新建不卡、画板 / 图块池 / 显卡上的图和帧缓冲 / three 的几何 / 缓冲区都回到只开一份时的水平" },
  { "when": ["src/minccino/", "src/look/", "src/editor/pool-mesh.ts", "src/editor/stream-provider.ts", "src/editor/profile-edges.ts", "src/editor/overlay"], "probes": ["probe-render-baseline.mjs", "probe-style.mjs", "probe-onebit.mjs", "probe-xray.mjs", "probe-texture-srgb.mjs", "probe-paint-display.mjs"], "why": "渲染：截图基线必跑" },
  { "when": ["src/scene/"], "probes": ["probe-scene.mjs", "probe-pool-mesh.mjs", "probe-render-baseline.mjs", "probe-hierarchy.mjs"], "why": "场景 / 视图契约" },
  { "when": ["src/format/", "src/identity/"], "probes": ["probe-export.mjs", "probe-import-glb.mjs", "probe-paste-conflict.mjs", "probe-shelf.mjs", "probe-textures-table.mjs"], "why": "文件读写 / 身份层" },
  { "when": ["src/app-store.ts", "src/store-ui.ts", "src/app/session.ts", "src/app/gallery-home.ts", "src/app/gallery-host.ts", "src/app/home-move.ts", "src/app/put-back.ts", "src/app/cloud-", "src/app/push-retry.ts", "src/app/crash-", "src/app/factory-reset.ts", "src/app/export-all.ts"], "probes": ["probe-cloud-gate.mjs", "probe-folder-home.mjs", "probe-save-collision.mjs", "probe-push-ask.mjs", "probe-update-conflict.mjs", "probe-no-home-dispose.mjs"], "why": "存盘 / 同步 / 图库的家" },
  { "when": ["src/crypto/", "src/crypto-state.ts", "src/encryption.ts", "src/password-verifier.ts", "src/remember-password.ts", "src/app/unlock.ts", "src/app/shadow-seal.ts"], "probes": ["probe-password.mjs", "probe-c2.mjs", "probe-present-lock.mjs"], "why": "口令 / 加密件" },
  { "when": ["src/controller/", "src/app/mfd.ts", "src/app/input-dom.ts", "src/app/gestures.ts"], "probes": ["probe-mfd.mjs", "probe-rail.mjs", "probe-tool-locks.mjs", "probe-input-gate.mjs", "probe-lock-line.mjs"], "why": "输入 / 芯片 / 左柱 / 锁" },
  { "when": ["src/app/"], "probes": ["probe-rail.mjs", "probe-menu-tabs.mjs", "probe-context.mjs", "probe-hierarchy.mjs"], "why": "界面壳（菜单、左柱、层级窗）" },
  { "when": ["src/player/", "src/app/vr.ts", "src/app/locomotion.ts", "src/app/touch-controls.ts"], "probes": ["probe-walk.mjs", "probe-walk-pen.mjs", "probe-touch-stick.mjs", "probe-xr-fake.mjs"], "why": "步行 / VR" },
  { "when": ["index.html", "service-worker.js", "boot-guard.js", "styles.css", "manifest.webmanifest", "scripts/build.sh"], "probes": ["probe-hover.mjs", "probe-factory-reset.mjs", "probe-moved-notice.mjs"], "why": "壳：页面、离线缓存、构建（另外跑 npm run smoke）" }
 ]
