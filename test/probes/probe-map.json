  { "when": ["src/paint/save.ts", "src/paint/boards.ts", "src/app/session.ts", "src/format/texture-table.ts", "src/minccino/providers/three/render3.ts"], "probes": ["probe-paint-save.mjs"], "why": "画存进文件、读回来（1-8b）：冷的照合成图显示、冷热逐像素相同、落笔撞冷画、编码中改动仍算改过、编码出错不动文件" },
