  { "when": ["src/paint/", "src/minccino/contract/offscreen-gpu.ts", "src/minccino/providers/three/offscreen-gpu-gl.ts", "src/minccino/providers/three/render3.ts", "src/app/session.ts", "src/app/paint-meter-badge.ts"], "probes": ["probe-paint-scale.mjs", "probe-paint-open-memory.mjs"], "why": "打开一张画占多少显存 = 面板上说的（施工单十五，open-memory.ts 那张清单）；画的规模样本（1-4c 门禁：改画的显示 / 笔 / 存盘都跑）：细分盒子 96…24576 张面都画得上、6144 张面整条（带强行对称、4194304 格各一遍）、每张面三角形上限；连续画 300 帧的各段读数（L 节，读数角标逐帧记 record）；真模型那一档手动加 --models=…" },
  { "when": ["src/minccino/providers/three/live-image.ts", "src/paint/board.ts", "src/paint/boards.ts", "src/paint/space-layer.ts", "src/paint/space-paint.ts", "src/minccino/contract/stream.ts", "src/paint/brush-kinds.ts", "src/paint/brush-records.ts", "src/paint/display-diag.ts", "src/app/paint-meter-badge.ts", "src/minccino/contract/pixel-diff.ts"], "probes": ["probe-live-region.mjs", "probe-paint-display.mjs"], "why": "显示图只拷变了的那一块、缩小图只重做受影响的那一块（1-4d 第 6 条）：增量 = 整张重拷逐字节（画到一半 / 抬笔 / 撤销 / 再画），每帧拷多大一块" },
