# journals/ journal/ = 纯人类区（家族硬规则 #2），不进 git
journals/
journal/
.claude/
node_modules/
# tools/ = 构建工具（esbuild 二进制跨 OS 不通用，build.sh 自动 curl）；区别于运行时 vendor
tools/
*.log
.DS_Store
# dist/catsup-<hash>.mjs 进 git（家族约定：各分支自己 commit 好 dist，部署只搬不重 build）；sourcemap 不进
dist/*.map
# site 仓本地 checkout（scripts/push-dist.sh 用；公仓只收构建产物）
.site/
