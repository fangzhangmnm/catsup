{
  "name": "catsup",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "comment": "0.4 VR 纪元（0.3 app 壳纪元之上）：纯 TS 几何内核 + three（vendored）正式 app。运行时零 npm 依赖；node 24 strip-types 直跑 test/；devDependencies 仅供 tsc --noEmit 类型门。版本 SSoT = src/version.ts（package.json 只跟着记）。",
  "scripts": {
    "test": "node test/run.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "bash scripts/build.sh",
    "probe": "node scripts/probe-boot.mjs",
    "deploy:dev": "bash scripts/push-dist.sh dev"
  },
  "devDependencies": {
    "typescript": "5.7.3"
  },
  "dependencies": {
    "@internal/store": "file:./vendor-pkgs/internal-store-0.14.0.tgz",
    "@internal/encryption": "file:./vendor-pkgs/internal-encryption-0.1.0.tgz",
    "@internal/gallery": "file:./vendor-pkgs/internal-gallery-0.4.0.tgz",
    "@internal/workbench-elements": "file:./vendor-pkgs/internal-workbench-elements-0.1.0.tgz"
  }
}
